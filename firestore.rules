rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo é legível para verificação e cálculo; modificável por administradores autenticados ou backend
    match /catalogo/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Pedidos de proposta geridos pela aplicação
    match /pedidos/{pedidoId} {
      allow read, write: if true;
    }

    // Propostas comerciais geridas pela aplicação
    match /propostas/{propostaId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
