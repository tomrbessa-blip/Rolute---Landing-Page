# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (default: gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# RESEND_API_KEY: API key from Resend (resend.com) for internal notifications to student.
# Configure this in the Secrets panel in AI Studio UI.
RESEND_API_KEY=""

# EMAIL_ALUNO: The email address associated with the student's Resend account.
# Internal proposal notifications are strictly sent to this address using onboarding@resend.dev.
EMAIL_ALUNO="tomrbessa@gmail.com"

# ADMIN_UID: Firebase user UID authorized as administrator for /admin.
# Obtain this by signing in with Google at /admin and copying your UID.
ADMIN_UID=""

# APP_URL / APP_BASE_URL: Public URL of the application.
APP_URL="MY_APP_URL"
APP_BASE_URL="MY_APP_URL"
